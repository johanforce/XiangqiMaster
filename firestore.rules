rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate document IDs
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny for unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Usernames uniqueness registry
    match /usernames/{username} {
      allow read, write: if true;
    }

    // Server-only secret store for password hashes
    match /userSecrets/{userId} {
      allow read, write: if false;
    }

    // Elo Ratings
    match /ratings/{ratingId} {
      allow read, write: if true;
    }

    // Match games & moves
    match /games/{gameId} {
      allow read, write: if true;

      match /moves/{moveId} {
        allow read, write: if true;
      }
    }

    match /moves/{moveId} {
      allow read, write: if true;
    }

    // Rating History
    match /ratingHistory/{historyId} {
      allow read, write: if true;
    }

    // Realtime game rooms
    match /rooms/{roomCode} {
      allow read, write: if true;
    }

    // System configuration
    match /adminConfig/{configId} {
      allow read, write: if true;
    }

    // Backward-compatibility collections for competition accounts & ranked matches
    match /competition_accounts/{username} {
      allow read, write: if true;
    }

    match /ranked_matches/{matchId} {
      allow read, write: if true;
    }
  }
}
