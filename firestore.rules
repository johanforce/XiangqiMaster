rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate document IDs
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny for unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection (includes password field for server-verified login)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Usernames uniqueness registry
    match /usernames/{username} {
      allow read, write: if true;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Concurrent login reset requests
    match /loginRequests/{requestId} {
      allow read, write: if true;
    }

    // Elo Ratings
    match /ratings/{ratingId} {
      allow read, write: if true;
    }

    // Match games & moves
    match /games/{gameId} {
      allow read, write: if true;

      match /moves/{moveId} {
        allow read, write: if true;
      }
    }

    match /moves/{moveId} {
      allow read, write: if true;
    }

    // Rating History
    match /ratingHistory/{historyId} {
      allow read, write: if true;
    }

    // Realtime game rooms
    match /rooms/{roomCode} {
      allow read, write: if true;
    }

    // System configuration
    match /adminConfig/{configId} {
      allow read, write: if true;
    }

    // Backward-compatibility collections for competition accounts & ranked matches
    match /competition_accounts/{username} {
      allow read, write: if true;
    }

    match /ranked_matches/{matchId} {
      allow read, write: if true;
    }

    // Tàng Thư (Library articles)
    match /articles/{articleId} {
      allow read, write: if true;
    }

    // =========================================================================
    // STAGING INDEPENDENT COLLECTIONS (Môi trường Thử nghiệm Staging độc lập)
    // =========================================================================
    match /staging_users/{userId} {
      allow read, write: if true;
    }

    match /staging_usernames/{username} {
      allow read, write: if true;
    }

    match /staging_admins/{adminId} {
      allow read, write: if true;
    }

    match /staging_loginRequests/{requestId} {
      allow read, write: if true;
    }

    match /staging_ratings/{ratingId} {
      allow read, write: if true;
    }

    match /staging_games/{gameId} {
      allow read, write: if true;

      match /moves/{moveId} {
        allow read, write: if true;
      }
    }

    match /staging_moves/{moveId} {
      allow read, write: if true;
    }

    match /staging_ratingHistory/{historyId} {
      allow read, write: if true;
    }

    match /staging_rooms/{roomCode} {
      allow read, write: if true;
    }

    match /staging_adminConfig/{configId} {
      allow read, write: if true;
    }

    match /staging_articles/{articleId} {
      allow read, write: if true;
    }
  }
}

